<h2>New Message</h2>

<p>Hello{{#if recipient_name}} {{recipient_name}}{{/if}},</p>

<p>You have received a new message regarding <strong>Job #{{job_number}}</strong>.</p>

{{#if defendant_name}}
<div class="info-box">
  <p><strong>Recipient:</strong> {{defendant_name}}</p>
  {{#if case_number}}<p><strong>Case Number:</strong> {{case_number}}</p>{{/if}}
</div>
{{/if}}

<h3 style="color: #1e293b; font-size: 16px; margin: 24px 0 12px 0;">Message</h3>
<div class="info-box" style="background-color: #eff6ff; border-left-color: #3b82f6;">
  <p style="white-space: pre-wrap; margin: 0;">{{note_content}}</p>
  <p style="font-size: 12px; color: #64748b; margin-top: 12px;">
    From: {{author_name}} &bull; {{formatDate sent_at 'MMMM d, yyyy h:mm a'}}
  </p>
</div>

{{#if portal_url}}
<p style="text-align: center; margin-top: 24px;">
  <a href="{{portal_url}}" class="button">View Job & Reply</a>
</p>
{{/if}}

<p style="font-size: 13px; color: #64748b; text-align: center; margin-top: 16px;">
  If you have any questions, please don't hesitate to contact us.
</p>
